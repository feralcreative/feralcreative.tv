# MediaMTX Configuration for 3 TP-Link C211 Cameras and an optional OBS feed
# https://github.com/bluenviron/mediamtx

# General settings
logLevel: info
logDestinations: [stdout]
logFile: /dev/stdout

# Authentication. The site serves no audio, so remote readers may only read the
# video-only paths. Raw sources with audio (cam_other) are readable only from
# inside this container, where ffmpeg strips the audio and republishes.
# The camera account publishes the OBS feed and drives the API (the backend
# uses it to turn feeds on and off).
authMethod: internal
authInternalUsers:
  - user: any
    pass:
    ips: []
    permissions:
      - action: read
        path: ~^cam_(left|right|top)(_low)?$
      - action: read
        path: cam_other_video
  - user: "${CAMERA_USER}"
    pass: "${CAMERA_PASS}"
    ips: []
    permissions:
      - action: publish
        path: cam_other
      - action: api
  - user: any
    pass:
    ips: ["127.0.0.1", "::1"]
    permissions:
      - action: publish
      - action: read
      - action: api
      - action: metrics
      - action: pprof

# API settings
api: yes
apiAddress: :9997

# Metrics
metrics: yes
metricsAddress: :9998

# WebRTC is off: the frontend is HLS-only, and WebRTC would carry camera audio.
webrtc: no

# HLS settings
hls: yes
hlsAddress: :8888
hlsAlwaysRemux: yes
hlsVariant: lowLatency
hlsSegmentCount: 7
hlsSegmentDuration: 1s
hlsPartDuration: 200ms

# RTSP settings
rtspAddress: :8554
rtspEncryption: "no"
rtspAuthMethods: [basic]

# OBS publishes H.264/AAC here; Docker host port publication is configured separately.
rtmp: yes
rtmpAddress: :1935

# Every public path is video only. ffmpeg copies the video track without
# re-encoding and drops audio (-map 0:v:0). Commands use literal path names
# because envsubst would blank MediaMTX's $MTX_PATH variables.
paths:
  # LEFT Camera (192.168.1.201)
  cam_left:
    runOnInit: ffmpeg -hide_banner -loglevel error -rtsp_transport tcp -i rtsp://${CAMERA_USER}:${CAMERA_PASS}@192.168.1.201:554/stream1 -map 0:v:0 -c copy -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/cam_left
    runOnInitRestart: yes

  cam_left_low:
    runOnInit: ffmpeg -hide_banner -loglevel error -rtsp_transport tcp -i rtsp://${CAMERA_USER}:${CAMERA_PASS}@192.168.1.201:554/stream2 -map 0:v:0 -c copy -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/cam_left_low
    runOnInitRestart: yes

  # RIGHT Camera (192.168.1.203)
  cam_right:
    runOnInit: ffmpeg -hide_banner -loglevel error -rtsp_transport tcp -i rtsp://${CAMERA_USER}:${CAMERA_PASS}@192.168.1.203:554/stream1 -map 0:v:0 -c copy -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/cam_right
    runOnInitRestart: yes

  cam_right_low:
    runOnInit: ffmpeg -hide_banner -loglevel error -rtsp_transport tcp -i rtsp://${CAMERA_USER}:${CAMERA_PASS}@192.168.1.203:554/stream2 -map 0:v:0 -c copy -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/cam_right_low
    runOnInitRestart: yes

  # TOP Camera (192.168.1.202)
  cam_top:
    runOnInit: ffmpeg -hide_banner -loglevel error -rtsp_transport tcp -i rtsp://${CAMERA_USER}:${CAMERA_PASS}@192.168.1.202:554/stream1 -map 0:v:0 -c copy -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/cam_top
    runOnInitRestart: yes

  cam_top_low:
    runOnInit: ffmpeg -hide_banner -loglevel error -rtsp_transport tcp -i rtsp://${CAMERA_USER}:${CAMERA_PASS}@192.168.1.202:554/stream2 -map 0:v:0 -c copy -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/cam_top_low
    runOnInitRestart: yes

  # SKYLINE: OBS publishes here with audio; only this container can read it.
  cam_other:
    source: publisher
    overridePublisher: no
    runOnAvailable: ffmpeg -hide_banner -loglevel error -rtsp_transport tcp -i rtsp://127.0.0.1:8554/cam_other -map 0:v:0 -c copy -f rtsp -rtsp_transport tcp rtsp://127.0.0.1:8554/cam_other_video
    runOnAvailableRestart: yes

  # SKYLINE as served: video only. nginx maps /cam_other/ here.
  cam_other_video:
    source: publisher
