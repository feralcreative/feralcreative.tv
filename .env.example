# Cloudflare Configuration
# Get your API token from: https://dash.cloudflare.com/profile/api-tokens
# Required scopes: Zone.Cache Purge
CLOUDFLARE_API_TOKEN=your_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here

# SSH Configuration (optional - will auto-detect if not set)
# SSH_KEY_PATH=/path/to/your/ssh/key

# NAS Configuration (optional - overrides defaults in deploy.config)
# NAS_SSH_PORT=33725

# Camera Configuration
# Create camera accounts in the Tapo app first
# Settings > Advanced Settings > Camera Account
CAMERA_USER=your_camera_username
CAMERA_PASS=your_camera_password

# Camera IP Addresses (static IPs on 192.168.1.0/24 network)
CAMERA_LEFT_IP=192.168.1.201
CAMERA_RIGHT_IP=192.168.1.203
CAMERA_TOP_IP=192.168.1.202
CAMERA_OTHER_IP=192.168.1.204

# Emailed sign-in links (Resend). Use a "Sending access" key limited to the sending domain;
# 1Password item "Resend API Key (feralcreative.tv)". MAIL_FROM must be on a verified domain.
RESEND_API_KEY=
MAIL_FROM="feralcreative.tv <signin@feralcreative.tv>"
# Local only: with no key, write each link to the backend log instead of emailing it.
# MAGIC_LINK_DEV_LOG=true

# ONVIF Test Mode
# Set to 'true' to test ONVIF controls without real cameras
# Useful when developing away from home network
TEST_MODE=false
